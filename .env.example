# MailDesk environment variables
# Copy to .env.local for local development. In AWS, enter the same keys in
# Amplify > App settings > Environment variables. Never commit real values.

# Google Cloud OAuth 2.0 Web application credentials (required)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-client-secret

# Production: your final AWS Amplify URL, with no trailing slash.
# Local fallback remains http://localhost:3000 when this variable is omitted.
NEXT_PUBLIC_APP_URL=https://main.example-id.amplifyapp.com
# Recommended explicit OAuth callback. It must also be registered in Google Cloud.
GOOGLE_REDIRECT_URI=https://main.example-id.amplifyapp.com/api/auth/google/callback

# Existing Supabase Cloud project (required for durable scheduling)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Use the same random value in Amplify and the AWS scheduler Lambda (required).
# Generate with: openssl rand -hex 32
CRON_SECRET=replace-with-at-least-32-random-characters

# Exactly 64 hexadecimal characters. Do not change after Gmail is connected,
# because existing encrypted refresh tokens depend on it.
# Generate with: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=replace-with-64-hexadecimal-characters

DEFAULT_TIMEZONE=Asia/Kolkata
