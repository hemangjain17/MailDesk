# ==============================================================================
# MailDesk — Environment Variables & Configuration for Vercel & Local
# ==============================================================================
# Copy this file to '.env.local' for local development:
#   cp .env.example .env.local
#
# For Vercel Deployment:
# Add these variables under your Vercel Project Settings -> Environment Variables.
# NEVER commit real credentials to your Git repository.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. GOOGLE OAUTH & GMAIL API (Required)
# ------------------------------------------------------------------------------
# Create in Google Cloud Console: APIs & Services -> Credentials -> OAuth 2.0 Client IDs
# Application Type: Web application
#
# Required Scopes:
#   - https://www.googleapis.com/auth/gmail.send
#   - https://www.googleapis.com/auth/gmail.readonly
#   - https://www.googleapis.com/auth/userinfo.email
#   - https://www.googleapis.com/auth/userinfo.profile
#
# Authorized Redirect URIs:
#   - For local:  http://localhost:3000/api/auth/google/callback
#   - For Vercel: https://<your-vercel-domain>.vercel.app/api/auth/google/callback
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-google-client-secret

# ------------------------------------------------------------------------------
# 2. APPLICATION URL (Recommended for Production)
# ------------------------------------------------------------------------------
# Set to your production Vercel URL (e.g. https://maildesk.vercel.app).
# If omitted on Vercel, the app automatically falls back to Vercel's system VERCEL_URL.
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# Optional: Default timezone for scheduling dates (default: Asia/Kolkata)
DEFAULT_TIMEZONE=Asia/Kolkata

# ------------------------------------------------------------------------------
# 3. SUPABASE CLOUD (Optional / Database Persistence)
# ------------------------------------------------------------------------------
# Find in Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here
# Service role key is secret and ONLY used server-side:
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-here

# ------------------------------------------------------------------------------
# 4. BACKGROUND CRON & WORKER AUTHENTICATION (Optional for Vercel Cron)
# ------------------------------------------------------------------------------
# Vercel Cron automatically handles authorization when deployed.
# You can set a secret token for manual curl/trigger calls:
# Header format: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=generate-a-secure-random-string-for-cron-jobs

# ------------------------------------------------------------------------------
# 5. TOKEN ENCRYPTION KEY (Optional)
# ------------------------------------------------------------------------------
# Used as the encryption key for OAuth tokens stored in Supabase.
# If omitted, a secure built-in application secret key is used automatically.
TOKEN_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
