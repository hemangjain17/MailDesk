# ==============================================================================
# MailDesk — Universal Environment Secrets & Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env.local':
#    cp .env.example .env.local
# 2. Fill in the real credentials below.
# 3. NEVER commit '.env.local' or any '.env' file containing real secrets to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE CLOUD (https://supabase.com/dashboard)
# ------------------------------------------------------------------------------
# Find these in: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here
# Service Role key is secret and ONLY used server-side by cron / background worker:
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-here

# ------------------------------------------------------------------------------
# 2. GOOGLE OAUTH & GMAIL API (https://console.cloud.google.com/)
# ------------------------------------------------------------------------------
# Required scopes:
# - https://www.googleapis.com/auth/gmail.send
# - https://www.googleapis.com/auth/gmail.readonly
# - https://www.googleapis.com/auth/userinfo.email
#
# Create under: APIs & Services -> Credentials -> Create Credentials -> OAuth client ID
# Application type: Web application
# Authorized redirect URIs: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# ------------------------------------------------------------------------------
# 3. TOKEN ENCRYPTION KEY (AES-256-GCM)
# ------------------------------------------------------------------------------
# Used to encrypt Google OAuth tokens in the Supabase database.
# Generate a random 32-byte (64-character hex) key by running:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ------------------------------------------------------------------------------
# 4. BACKGROUND CRON & WORKER AUTHENTICATION
# ------------------------------------------------------------------------------
# Secret token required in Authorization header when calling:
# - POST /api/cron/send-scheduled
# - POST /api/cron/sync-gmail
# - POST /api/cron/check-followups
# Header format: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=generate-a-secure-random-string-for-cron-jobs

# ------------------------------------------------------------------------------
# 5. APPLICATION SETTINGS
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
DEFAULT_TIMEZONE=Asia/Kolkata
